# Copy this file to .env and fill in the values from the Supabase dashboard:
# Project Settings > API (Project URL and the publishable key).
# Never put the secret / service_role key here: it bypasses Row Level Security.
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
